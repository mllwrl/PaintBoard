# Caddy in front of the server: HTTPS certificates are fetched automatically, so links
# work as wss://board.example.com. Replace the domain with yours. Caddy passes the
# client's address in X-Forwarded-For: run the server with PB_TRUST_PROXY=1 so its limits
# per address count clients, not Caddy (and keep its port closed to everyone else).
board.example.com {
	reverse_proxy localhost:8080
}
